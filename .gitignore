# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-cpu/

# Secrets & local env (surface_controls.py reads .env; never commit keys)
.env

# Data files
*.jsonl
*.json

# Generated results / artifacts — ignore everything under results/ EXCEPT the
# input datasets in results/data/. Sweeps up activations/, runs/, cells/,
# adapter_space*/, directions/, *.log, plots, and any future cache dirs.
results/*
!results/data/

# Large binaries: activation/verify caches and plots. Repo-root only (leading
# slash) so vendored verl/ assets stay tracked.
/*.pt
/*.png

# Local working notes / chat transcripts (not part of the pipeline)
chat_with_claude.txt
